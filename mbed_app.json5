{
    "target_overrides": {
        "*": {
            // Pinscape has no threads: mbed 2 had no RTOS at all, and the
            // KL25Z has 16 KB of RAM. With RTX linked in, the static data
            // overflowed the reserved region by 2312 bytes.
            "target.application-profile": "bare-metal",

            // The Mbed CE USB object makes main's stack frame about 2 KB.
            // Leave another 1 KB for calls and interrupt handlers. Use the
            // small C library to recover RAM for the sensor/input heap.
            "target.boot-stack-size": "0xC00",
            "target.c_lib": "small",

            // Endpoint 3 carries HID reports, so 64-byte packets suffice.
            // Avoid the default pair of 1023-byte buffers and recover 1918
            // bytes of RAM. Newer Mbed headers use this setting instead of
            // the literal definition handled by our legacy USB patch.
            "target.kinetis-max-packet-size-ep3": 64,

            // Release firmware never initializes the OpenSDA UART, including
            // on fatal errors. CMake enables it only for an explicitly selected
            // diagnostic build; it also checks for saved PTA1/PTA2 assignments.
            "target.console-uart": false,

            // printf without floating point or 64-bit integers.
            //
            // Mbed enables both by default, and each drags its own formatting
            // code into the image. Nothing this firmware prints needs them: the
            // only %f are under DEBUG_PRINTF, which is off. Turn either back on
            // if you enable that, and watch the flash budget.
            "platform.minimal-printf-enable-floating-point": false,
            "platform.minimal-printf-enable-64-bit": false,
            "platform.stdio-minimal-console-only": true
        }
    }
}
